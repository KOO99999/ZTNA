aws_region           = "ap-northeast-2"
aws_profile          = "your-aws-cli-profile"
cloudflare_api_token = "REPLACE_ME"
cloudflare_workers_api_token = "REPLACE_ME_WITH_WORKERS_SCRIPTS_EDIT_ONLY_TOKEN"
cloudflare_account_id = "REPLACE_ME"
cloudflare_zone_id    = "REPLACE_ME"
domain_name           = "app.yourdomain.com"
admin_allowed_emails = ["admin@example.com", "breakglass@yourdomain.com"]   # 두 번째는 비상 관리자(평소 미사용)
evaluate_shared_secret = "REPLACE_ME_WITH_OPENSSL_RAND_HEX_32_OUTPUT"
cloudflare_team_domain = "your-team.cloudflareaccess.com"
oidc_client_id     = "zt-login-server"
oidc_client_secret = "REPLACE_ME_WITH_OPENSSL_RAND_HEX_32_OUTPUT"

# 기기 등록 사용자 조회용(읽기 전용: Account > Zero Trust > Read). 비우면 기기 주인 확인만 꺼짐
cloudflare_device_read_token = "REPLACE_ME"
# 기기 신호 스위치: enforce(점수 반영) / report(로그에만, 기본값) / off(계산 안 함)
device_signal_mode = "report"
